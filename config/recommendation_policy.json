  "source_quality": {
    "prefer": [
      "original papers",
      "lab and researcher blogs",
      "official statements",
      "primary data",
      "reputable outlets with named sources"
    ],
    "avoid": [
      "content farms",
      "unattributed reposts",
      "engagement bait",
      "low-quality AI-generated content"
    ]
