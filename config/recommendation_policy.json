    },
    "growth": {
      "share": 0.25,
      "use": "develop: steady, small steps; every monthly package has at least one growth reading or exercise"
    },
    "exploration": {
      "share": 0.15,
      "use": "surprise: optional but never zero; something genuinely unfamiliar and worthwhile"
    }
  }
