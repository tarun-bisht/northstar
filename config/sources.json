{
  "_doc": "Operational sources. This is the ONE place for arXiv categories and YouTube search queries (scripts/fetch_candidates.py reads them). config/interests.json says what you care about; this file says where to look.",
  "arxiv": {
    "_doc": "Categories chosen for coverage, not completeness. Volume-heavy categories get higher limits so a 4-day lookback (covers weekends) isn't truncated.",
    "categories": [
      {
        "id": "cs.LG",
        "covers": "machine learning, optimization for ML, trustworthy ML, unlearning, evaluation"
      },
      {
        "id": "stat.ML",
        "covers": "statistical ML, learning theory"
      },
      {
        "id": "cs.AI",
        "covers": "AI broadly, agents, reasoning"
      },
      {
        "id": "cs.CL",
        "covers": "NLP and LLMs"
      },
      {
        "id": "cs.CV",
        "covers": "computer vision, multimodal models"
      },
      {
        "id": "cs.CR",
        "covers": "security and privacy: attacks, defenses, privacy, unlearning"
      },
      {
        "id": "cs.MA",
        "covers": "multi-agent systems"
      },
      {
        "id": "cs.DC",
        "covers": "distributed systems, efficient training and inference"
      },
      {
        "id": "math.OC",
        "covers": "optimization"
      }
    ],
    "max_results_per_category": 400,
    "max_results_overrides": {
      "cs.LG": 1200,
      "cs.CV": 800,
      "cs.CL": 800,
      "cs.AI": 800
    },
    "lookback_days": 4
  },
  "research_updates": {
    "lab_blogs": [
      "https://www.anthropic.com/research",
      "https://openai.com/research",
      "https://deepmind.google/discover/blog/",
      "https://ai.meta.com/blog/",
      "https://transformer-circuits.pub/",
      "https://www.alignmentforum.org/",
      "https://bair.berkeley.edu/blog/",
      "https://huggingface.co/blog"
