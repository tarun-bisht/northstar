{
  "_doc": "Operational sources. This is the ONE place for arXiv categories and YouTube search queries (scripts/fetch_candidates.py reads them). config/interests.json says what you care about; this file says where to look.",
  "arxiv": {
    "_doc": "Categories chosen for coverage, not completeness. Volume-heavy categories get higher limits so a 4-day lookback (covers weekends) isn't truncated. arXiv allows one request every 3 seconds on one connection; the fetcher spaces calls, retries 429/5xx with backoff, and falls back to rss.arxiv.org per category.",
    "categories": [
      {
        "id": "cs.LG",
        "covers": "machine learning, GNNs, generative and diffusion models, world models, trustworthy ML, unlearning, evaluation"
      },
      {
        "id": "stat.ML",
        "covers": "statistical ML, learning theory"
      },
      {
        "id": "cs.AI",
        "covers": "AI broadly, agents, reasoning"
      },
      {
        "id": "cs.CL",
        "covers": "NLP and LLMs"
      },
      {
        "id": "cs.CV",
        "covers": "computer vision, multimodal models"
      },
      {
        "id": "cs.CR",
        "covers": "security and privacy: attacks, defenses, privacy, unlearning"
      },
      {
        "id": "cs.MA",
        "covers": "multi-agent systems"
      },
      {
        "id": "cs.DC",
        "covers": "distributed systems, efficient training and inference"
      },
      {
        "id": "math.OC",
        "covers": "optimization"
      },
      {
        "id": "cs.IR",
        "covers": "information retrieval, search, recommender systems, RAG"
      },
      {
        "id": "cs.NE",
        "covers": "neural and evolutionary computing, neural combinatorial optimization"
      },
      {
        "id": "cs.DS",
        "covers": "algorithms and combinatorial optimization"
      },
      {
        "id": "cs.RO",
        "covers": "robotics, embodied agents, world models for control"
      },
      {
        "id": "q-bio.BM",
        "covers": "biomolecules: protein structure and design (AlphaFold-style models)"
      },
      {
        "id": "q-bio.QM",
        "covers": "quantitative methods: AI for biology and drug discovery"
      }
    ],
    "max_results_per_category": 400,
    "max_results_overrides": {
      "cs.LG": 1200,
      "cs.CV": 800,
      "cs.CL": 800,
      "cs.AI": 800
    },
    "lookback_days": 4
  },
