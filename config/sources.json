  "paper_tags": {
    "_doc": "The only tags a paper can get, in the arXiv radar and the weekly reading list. Fixed on purpose: reuse these, never invent new ones. Order matters: the first tag is shown first.",
    "tags": [
      "close to your work",
      "useful for your work",
      "new method or architecture",
      "strong result",
      "notable researcher",
      "benchmark or dataset",
      "theory",
      "survey or tutorial",
      "worth knowing"
    ]
