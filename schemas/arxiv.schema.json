{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsys.local/schemas/arxiv.schema.json",
  "title": "Daily arXiv paper radar",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/daily_envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "arxiv"
    },
    "candidates_considered": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      }
    }
  },
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "arxiv_id",
        "title",
        "authors",
        "url",
        "submitted",
        "categories",
        "abstract",
        "research_area",
        "tags"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "arxiv_id": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{4,5}$"
        },
        "version": {
          "type": "string",
          "pattern": "^v\\d+$"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "url": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "pdf_url": {
          "$ref": "common.schema.json#/$defs/url"
        },
        "submitted": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z-]+(\\.[A-Za-z-]+)?$"
          },
          "description": "arXiv categories, filled by the fetch (looked up for Hugging Face and alphaXiv papers). Empty only if that lookup failed: never guessed."
        },
        "abstract": {
          "type": "string",
          "minLength": 40,
          "description": "ORIGINAL abstract, verbatim from arXiv"
        },
        "abstract_source": {
          "enum": [
            "arxiv_api_candidates",
            "arxiv_abs_page",
            "huggingface_daily",
            "other_verbatim",
            "arxiv_rss",
            "alphaxiv_trending"
          ]
        },
        "research_area": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "dimensions": {
          "$ref": "common.schema.json#/$defs/dimensions"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "description": "From config/sources.json -> paper_tags only. No free-text reasons."
        },
        "hf_upvotes": {
          "type": "integer",
          "minimum": 0
        },
        "priority": {
          "enum": [
            "top",
            "more"
          ],
          "description": "top: the day's best picks, shown first. more: also passed the bar, shown folded under 'More papers'. Default top."
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "description": "Author affiliations from page 1 of the paper, when known."
        },
        "trusted": {
          "enum": [
            0,
            1
          ],
          "description": "1 when an author, affiliation or email domain matches config/reputation.json."
        },
        "lane": {
          "enum": [
            "strong",
            "field"
          ],
          "description": "strong: on the user's interests. field: important for the field even with little overlap."
        },
        "overview": {
          "type": "boolean",
          "description": "In the day's overview (at most 5 per part, shown first and left out of the main list)."
        }
      }
    }
  }
}
