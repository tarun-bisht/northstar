{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsys.local/schemas/quarterly.schema.json",
  "title": "Quarterly review: stats, a short summary and the topics covered",
  "type": "object",
  "required": ["schema", "quarter", "from", "to", "generated_at", "stats", "summary", "topics"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "quarterly"},
    "quarter": {"type": "string", "pattern": "^\\d{4}-Q[1-4]$"},
    "from": {"$ref": "common.schema.json#/$defs/date"},
    "to": {"$ref": "common.schema.json#/$defs/date"},
    "generated_at": {"$ref": "common.schema.json#/$defs/datetime"},
    "generator": {"type": "string"},
    "example": {"type": "boolean"},
    "stats": {
      "type": "object",
      "description": "Computed by `dsys.py quarterly draft`. Do not edit by hand.",
      "additionalProperties": false,
      "required": ["days_with_content", "counts", "discovery_by_tier", "top_paper_tags", "top_research_areas"],
      "properties": {
        "days_with_content": {"type": "integer", "minimum": 0},
        "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "discovery_by_tier": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "top_paper_tags": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "integer"}], "minItems": 2, "maxItems": 2}, "maxItems": 10},
        "top_research_areas": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "integer"}], "minItems": 2, "maxItems": 2}, "maxItems": 12}
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 900,
      "description": "Five or six short lines on research and discovery only: themes in papers and research updates, what weekly and monthly packages covered, what to lean into next. No shorts or news."
    },
    "topics": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["period", "kind", "title", "about"],
        "properties": {
          "period": {"type": "string"},
          "kind": {"enum": ["weekly", "monthly", "reading"]},
          "title": {"$ref": "common.schema.json#/$defs/nonempty"},
          "url": {"type": "string"},
          "about": {"type": "string", "maxLength": 200, "description": "One plain sentence on what the topic is."}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
