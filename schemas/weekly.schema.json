{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsys.local/schemas/weekly.schema.json",
  "title": "Optional weekly package",
  "type": "object",
  "required": [
    "schema",
    "week",
    "start_date",
    "end_date",
    "generated_at",
    "load",
    "intro",
    "items",
    "language"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "weekly"
    },
    "week": {
      "$ref": "common.schema.json#/$defs/isoweek"
    },
    "start_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "end_date": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/datetime"
    },
    "generator": {
      "type": "string"
    },
    "example": {
      "type": "boolean"
    },
    "load": {
      "$ref": "common.schema.json#/$defs/load"
    },
    "intro": {
      "$ref": "common.schema.json#/$defs/nonempty"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      },
      "minItems": 1,
      "maxItems": 16
    },
    "reflection_prompt": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessons"
      ],
      "properties": {
        "lessons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lesson"
          },
          "minItems": 1,
          "maxItems": 4
        }
      }
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "category",
        "dimensions",
        "description",
        "why",
        "time_estimate",
        "origin",
        "status",
        "tier"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "category": {
          "enum": [
            "research_fundamentals",
            "ai_study",
            "paper",
            "new_knowledge",
            "people",
            "teaching",
            "culture",
            "random_curiosity",
            "making",
            "world_understanding",
            "question",
            "talking_point",
            "user_idea",
            "reflection"
          ]
        },
        "dimensions": {
          "$ref": "common.schema.json#/$defs/dimensions"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "why": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "time_estimate": {
          "enum": [
            "10-30m",
            "30-60m",
            "1-2h",
            "few_hours",
            "real_world_practice"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Progressive hints, weakest first. Never the full solution."
        },
        "solution_available_on_request": {
          "type": "boolean"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/resource"
          }
        },
        "explain": {
          "type": "object",
          "description": "For ai_study: what/why/how/components/limitations/research relevance",
          "additionalProperties": false,
          "properties": {
            "what": {
              "type": "string"
            },
            "why": {
              "type": "string"
            },
            "how": {
              "type": "string"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "limitations": {
              "type": "string"
            },
            "research_relevance": {
              "type": "string"
            }
          }
        },
        "paper": {
          "type": "object",
          "description": "For category=paper",
          "additionalProperties": false,
          "required": [
            "title",
            "authors",
            "year",
            "url"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "authors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "year": {
              "type": "integer"
            },
            "url": {
              "$ref": "common.schema.json#/$defs/url"
            },
            "area": {
              "type": "string"
            },
            "what_to_notice": {
              "type": "string"
            },
            "reading_time": {
              "type": "string"
            },
            "difficulty": {
              "$ref": "common.schema.json#/$defs/difficulty"
            }
          }
        },
        "difficulty": {
          "$ref": "common.schema.json#/$defs/difficulty"
        },
        "origin": {
          "enum": [
            "system",
            "user_idea",
            "continued"
          ]
        },
        "idea_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "continues": {
          "$ref": "common.schema.json#/$defs/id",
          "description": "id of the earlier activity this continues"
        },
        "status": {
          "$ref": "common.schema.json#/$defs/activity_status"
        },
        "topic": {
          "type": "string",
          "description": "Short topic key used for preference learning, e.g. 'probability puzzles'"
        },
        "mode": {
          "$ref": "common.schema.json#/$defs/mode"
        },
        "then": {
          "type": "string",
          "description": "Optional follow-through that turns learning into practice/creation, e.g. 'explain it to a friend'"
        },
        "cross_domain": {
          "$ref": "common.schema.json#/$defs/cross_domain"
        },
        "tier": {
          "$ref": "common.schema.json#/$defs/tier"
        },
        "section": {
          "enum": [
            "research_practice",
            "research_reading",
            "questions",
            "talking_points",
            "culture",
            "people_self",
            "curiosity_making",
            "world"
          ],
          "description": "Section on the weekly page (prompts/weekly.md). Omit to derive it from category."
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "title",
        "explanation",
        "examples",
        "questions",
        "practice"
      ],
      "properties": {
        "language": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "explanation": {
          "type": "string",
          "minLength": 20
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/lang_line"
          },
          "minItems": 3
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/lang_question"
          },
          "minItems": 3
        },
        "practice": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "speaking/listening tasks"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/resource"
          }
        }
      }
    }
  }
}
