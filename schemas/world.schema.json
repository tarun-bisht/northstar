{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsys.local/schemas/world.schema.json",
  "title": "Daily world radar",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/daily_envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "world"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "regions",
        "topic",
        "what_happened",
        "why_it_matters",
        "what_to_watch",
        "confirmed_facts",
        "sources",
        "published"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "topic": {
          "enum": [
            "geopolitics",
            "international_relations",
            "economics",
            "finance",
            "business",
            "technology",
            "science",
            "society",
            "culture",
            "conflict",
            "disaster",
            "politics",
            "environment",
            "health",
            "trade",
            "energy",
            "climate",
            "migration",
            "demographics",
            "policy",
            "other"
          ]
        },
        "what_happened": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "what_to_watch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "context": {
          "type": "string",
          "maxLength": 300
        },
        "confirmed_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 4
        },
        "analysis": {
          "type": "string",
          "description": "Interpretation, clearly separate from confirmed facts",
          "maxLength": 250
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 160
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "minItems": 1
        },
        "published": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "follows_up": {
          "type": "string",
          "description": "id of an earlier world item this continues"
        },
        "dimensions": {
          "$ref": "common.schema.json#/$defs/dimensions"
        },
        "section": {
          "enum": [
            "india",
            "geopolitics",
            "conflict_disaster",
            "economy_markets",
            "business_tech",
            "science_health",
            "climate_energy",
            "society",
            "explainers"
          ],
          "description": "News category on the daily page (see prompts/world.md). Omit to derive it from topic and regions."
        }
      }
    }
  }
}
