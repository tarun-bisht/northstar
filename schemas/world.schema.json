{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsys.local/schemas/world.schema.json",
  "title": "Daily world radar",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/daily_envelope"
    }
  ],
  "properties": {
    "schema": {
      "const": "world"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "briefs": {
      "type": "array",
      "maxItems": 40,
      "description": "Also in the news: one-line headlines beyond the explained items, with links straight from the fetched candidates.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url",
          "source",
          "section"
        ],
        "properties": {
          "title": {
            "$ref": "common.schema.json#/$defs/nonempty"
          },
          "url": {
            "$ref": "common.schema.json#/$defs/url"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "enum": [
              "india",
              "geopolitics",
              "leadership",
              "conflict_disaster",
              "economy_markets",
              "business",
              "technology",
              "science_space",
              "health",
              "climate_energy",
              "society",
              "explainers"
            ]
          },
          "line": {
            "type": "string",
            "maxLength": 200
          },
          "published": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "regions",
        "topic",
        "what_happened",
        "why_it_matters",
        "what_to_watch",
        "confirmed_facts",
        "sources",
        "published"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "title": {
          "$ref": "common.schema.json#/$defs/nonempty"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "topic": {
          "enum": [
            "geopolitics",
            "international_relations",
            "economics",
            "finance",
            "business",
            "technology",
            "science",
            "society",
            "culture",
            "conflict",
            "disaster",
            "politics",
            "environment",
            "health",
            "trade",
            "energy",
            "climate",
            "migration",
            "demographics",
            "policy",
            "other"
          ]
        },
        "what_happened": {
          "type": "string",
          "minLength": 1,
          "maxLength": 280
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 220
        },
        "what_to_watch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "context": {
          "type": "string",
          "maxLength": 300
        },
        "confirmed_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 4
        },
        "analysis": {
          "type": "string",
          "description": "Interpretation, clearly separate from confirmed facts",
          "maxLength": 250
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 160
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "minItems": 1
        },
        "published": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "follows_up": {
          "type": "string",
          "description": "id of an earlier world item this continues"
        },
        "dimensions": {
          "$ref": "common.schema.json#/$defs/dimensions"
        },
        "section": {
          "enum": [
            "india",
            "geopolitics",
            "leadership",
            "conflict_disaster",
            "economy_markets",
            "business",
            "technology",
            "science_space",
            "health",
            "climate_energy",
            "society",
            "explainers",
            "business_tech",
            "science_health"
          ],
          "description": "News category (prompts/world.md). business_tech and science_health are older values."
        },
        "lesson": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "concept",
            "explanation"
          ],
          "description": "What this story teaches: the concept, mechanism or bit of history behind it, explained so it sticks (how a central bank fights inflation, why monsoons fail, how sanctions bite). Required for explained items from 2026-11-27.",
          "properties": {
            "concept": {
              "$ref": "common.schema.json#/$defs/nonempty"
            },
            "explanation": {
              "$ref": "common.schema.json#/$defs/nonempty"
            },
            "learn_more": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "$ref": "common.schema.json#/$defs/url"
                }
              }
            }
          }
        },
        "start_here": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "One line on why to start the day with this item (at most one per stream per day)."
        }
      }
    }
  }
}
